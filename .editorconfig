root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.{ts,js,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning

# 命名
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = i_prefixed
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefixed.required_prefix = I

# 开发计划 §5.7 / R4：禁止线程静态状态
dotnet_diagnostic.RS0030.severity = error

# 允许以 ACT_* 表名 / 列名作为常量与成员名（对齐 Activiti DDL，见 §7.1）
dotnet_diagnostic.CA1707.severity = none

# 类名有意对齐 Activiti（如 IServiceTaskDelegate ← JavaDelegate、ExtensionAttribute），
# 见 §1.1 L2「同元素名、同属性名」：便于比对、招聘与查资料，优先于 .NET 命名惯例。
dotnet_diagnostic.CA1711.severity = none

# 引擎内部日志全部在低频路径（每命令 / 每操作一次），信息量与可读性优先于
# LoggerMessage 源生成的微优化。高频热路径（操作循环内部）已显式做 IsEnabled 判定。
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none

# ── 测试工程：只留下「可能指向真 bug」的规则 ───────────────────────────────
# tests/ 下的工程关闭了 TreatWarningsAsErrors（见 Directory.Build.props），
# 所以这里的界线必须自己划清楚：否则 400+ 条机械提示会把真正该看的警告淹掉。
# 原则：正确性 / 文化 / 可空性类规则保持 warning；纯风格与微优化降为 suggestion
# （IDE 里仍有灰点提示，只是不再污染 build 输出）。
[tests/**/*.cs]
# xUnit1051：建议给每个接受 CancellationToken 的调用补 TestContext.Current.CancellationToken。
# 本仓库测试是短时用例，机械补 400+ 处换来的可取消性收益远低于噪音成本。
dotnet_diagnostic.xUnit1051.severity = suggestion
# xUnit1030：测试方法内不该 ConfigureAwait(false)（会绕过 xUnit 的并行度限制）。
# 现有用例无并行度依赖，降为提示，留给后续顺手清理。
dotnet_diagnostic.xUnit1030.severity = suggestion
# 断言风格建议：集合大小 / 不存在的判断改用 Single、Empty、DoesNotContain。
dotnet_diagnostic.xUnit2013.severity = suggestion
dotnet_diagnostic.xUnit2029.severity = suggestion
# 微优化：常量数组提为 static readonly；可索引集合别绕 Enumerable；
# 字段/返回值收窄成具体类型；Regex.Count 替代 Regex.Matches(...).Count。
# 测试辅助代码优先可读性（对接口编程），这几条带来的收益可忽略。
dotnet_diagnostic.CA1861.severity = suggestion
dotnet_diagnostic.CA1826.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1875.severity = suggestion
# CA1822：xUnit 要求测试方法为实例方法，只有辅助方法能标 static。
dotnet_diagnostic.CA1822.severity = suggestion
