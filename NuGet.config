<?xml version="1.0" encoding="utf-8"?>
<!--
  NetBpm 只依赖公开包（Dapper / 数据库驱动 / Microsoft.Extensions.* / xUnit / Testcontainers）。

  这里显式 <clear /> 掉继承来的包源，原因有二：
    1) 本机全局配置中的企业源为 HTTP 源，NuGet 现已拒绝通过 HTTP 还原（NU1302）；
    2) 使用中央包管理（CPM）时，多个包源会触发 NU1507。

  如需引入企业内部包，请在此文件追加 <add key="..." value="https://..." /> 并保持 HTTPS。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
