<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NetBpm.UnitTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 SDK 起 dotnet test 只支持 Microsoft.Testing.Platform -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetBpm.Bpmn.Converter\NetBpm.Bpmn.Converter.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Bpmn.Model\NetBpm.Bpmn.Model.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Bpmn.Validation\NetBpm.Bpmn.Validation.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.El\NetBpm.El.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Engine\NetBpm.Engine.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Persistence\NetBpm.Persistence.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Runtime\NetBpm.Runtime.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Workflow\NetBpm.Workflow.csproj" />
    <!-- M15：官方 SDK 的传输层单测（假 handler，不起宿主） -->
    <ProjectReference Include="..\..\src\NetBpm.Platform.Client\NetBpm.Platform.Client.csproj" />
    <!-- M15：SDK 生成器的产物必须与快照一致（纯函数，不需要数据库） -->
    <ProjectReference Include="..\..\tools\NetBpm.SdkGen\NetBpm.SdkGen.csproj" />
    <!-- 库脚本必须与 SchemaCatalog 的渲染结果一致（漂移守门，纯字符串比对） -->
    <ProjectReference Include="..\..\tools\NetBpm.DbInit\NetBpm.DbInit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
