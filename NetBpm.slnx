<Solution>
  <Folder Name="/src/">
    <Project Path="src/NetBpm.Bpmn.Model/NetBpm.Bpmn.Model.csproj" />
    <Project Path="src/NetBpm.Bpmn.Converter/NetBpm.Bpmn.Converter.csproj" />
    <Project Path="src/NetBpm.Bpmn.Validation/NetBpm.Bpmn.Validation.csproj" />
    <Project Path="src/NetBpm.El/NetBpm.El.csproj" />
    <Project Path="src/NetBpm.Engine/NetBpm.Engine.csproj" />
    <Project Path="src/NetBpm.Persistence/NetBpm.Persistence.csproj" />
    <Project Path="src/NetBpm.Identity/NetBpm.Identity.csproj" />
    <Project Path="src/NetBpm.Runtime/NetBpm.Runtime.csproj" />
    <Project Path="src/NetBpm.Rest/NetBpm.Rest.csproj" />
    <Project Path="src/NetBpm.Admin/NetBpm.Admin.csproj" />
    <!-- S4 独立部署形态的生产宿主：默认要求凭据、默认连数据库、启动自检不过就失败 -->
    <Project Path="src/NetBpm.Platform.Service/NetBpm.Platform.Service.csproj" />
    <Project Path="src/NetBpm.Workflow/NetBpm.Workflow.csproj" />
    <!-- 平台对外契约（不引用任何引擎工程，见 docs/platform-api-refactoring-plan.md §2.2） -->
    <Project Path="src/NetBpm.Platform.Contracts/NetBpm.Platform.Contracts.csproj" />
    <!-- M15 官方 SDK：只依赖契约工程（不引用引擎，见 §2.2 依赖铁律） -->
    <Project Path="src/NetBpm.Platform.Client/NetBpm.Platform.Client.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/NetBpm.UnitTests/NetBpm.UnitTests.csproj" />
    <Project Path="tests/NetBpm.IntegrationTests/NetBpm.IntegrationTests.csproj" />
    <Project Path="tests/NetBpm.DifferentialTests/NetBpm.DifferentialTests.csproj" />
  </Folder>
  <Folder Name="/samples/">
    <Project Path="samples/NetBpm.Demo/NetBpm.Demo.csproj" />
    <!-- S4：外部任务 worker —— 刻意不引用任何 NetBpm 工程，只靠 HTTP + JSON 与平台通信 -->
    <Project Path="samples/NetBpm.ExternalWorker/NetBpm.ExternalWorker.csproj" />
  </Folder>
  <Folder Name="/tools/">
    <Project Path="tools/NetBpm.DbMigrate/NetBpm.DbMigrate.csproj" />
    <Project Path="tools/NetBpm.DbInit/NetBpm.DbInit.csproj" />
    <!-- M15：从 OpenAPI 快照生成 TS / Java 模型（产物在 sdk/，由 SdkGenerationTests 守门） -->
    <Project Path="tools/NetBpm.SdkGen/NetBpm.SdkGen.csproj" />
    <!-- §9.3：自建语料必须由脚本生成（放在 tests/corpus/generator 便于语料与生成器同处一地） -->
    <Project Path="tests/corpus/generator/NetBpm.CorpusGenerator.csproj" />
    <!-- §9.3：现成语料（Activiti 测试资源）由导入器收录，脚本自动生成 -->
    <Project Path="tests/corpus/importer/NetBpm.CorpusImporter.csproj" />
  </Folder>
</Solution>
