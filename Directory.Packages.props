<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!--
    开发计划 §3 技术选型：
      Dapper（不用 EF Core）/ 自研 NetBpm.El（不引第三方表达式库）/ xUnit + Testcontainers
  -->
  <ItemGroup Label="Analyzer">
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <!-- 脚本任务（二期 §1.2）：Roslyn C# Scripting —— scriptFormat="csharp" -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- 独立部署形态（S4）的 worker 是独立进程：需要 HttpClientFactory 与控制台日志。
         Web 宿主由共享框架自带这两个能力，控制台工程没有。 -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="AspnetCore">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- 可选 JWT 鉴权（HS256）：与服务间 API Key 并存 -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <!-- 可选 OTel 接线：宿主按配置决定是否经 OTLP 导出管理治理指标（Meter 本身零依赖） -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.9.0" />
    <!-- HTTP 入口链路追踪（WithTracing），默认关闭、随 OTel 开关一起启用 -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup Label="JobQueue">
    <!-- 可选：仅当 NetBpm:Jobs:Queue:Provider = Redis 时才真正建连 -->
    <PackageVersion Include="StackExchange.Redis" Version="2.9.32" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- .NET 10 SDK 起 dotnet test 走 Microsoft.Testing.Platform，由 xunit.v3 自带 -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <!-- 端到端验收（P9）：在进程内起真实的 REST 宿主，走 HTTP 打通全链路 -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

</Project>
