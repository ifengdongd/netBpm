# 演示工程运行时产物（业务数据落成 JSON）
# 注意：直接跑 bin 下的 apphost 时 ContentRoot 是当前目录，可能在仓库根再生成一份 data/
samples/NetBpm.Demo/data/
# 流程图图片：发布后由 BpmnDiagramSvgRenderer 重新生成（见 Program.cs）
samples/NetBpm.Demo/wwwroot/diagrams/
/data/

# 本地工具工作区（不提交）
.playwright-cli/
.tools/

# Local credentials (never commit)
# Gitee 私人令牌，供 credential.helper=store 读取：git config --local credential.helper "store --file .gittoken"
.gittoken
*.gittoken
.git-credentials
git-credentials

# AI 工具本地工作区数据（不提交）
.workbuddy/

# Generated admin SPA sourcemaps (large, not needed at runtime)
src/NetBpm.Admin/wwwroot/**/*.map


# Frontend build output (built by CI / local scripts, no longer tracked)
src/NetBpm.Admin/wwwroot/

# Local OpenAPI export (generated by dev workflow, regenerate anytime)
web/admin/openapi.local.json

# Temporary build output (ad-hoc diagnostics)
.tmp-dbtools/
# 本地联调留下的临时文件：主机日志 / 进程号 / 浏览器脚本产物
.tmp-host-*.log
.tmp-host.pid
.tmp-browser/
