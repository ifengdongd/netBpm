{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    "//": "默认内存宿主：不接数据库也能把整条审批链跑通（切真库见 LeaveApproval Demo 的 appsettings.Development.json 组合）。",
    "DatabaseType": "MySql",
    "ConnectionString": "",
    "IdBlockSize": 2500,
    "EnableHistory": false,
    "UseInMemoryExecutionTree": true,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": false
  },
  "Workflow": {
    "//JsonDataFile": "流程引擎业务数据（实例登记 / 审批结论 / 参数表 / 审批记录 / 当前待办）的 JSON 落点；相对路径基于内容根。",
    "JsonDataFile": "data/order-workflow.json"
  },
  "Order": {
    "//BillDataFile": "订单业务数据（order_bill 行）的 JSON 落点；相对路径基于内容根。",
    "BillDataFile": "data/order-bill.json",
    "//TenantId": "order_bill.tenant_id，Demo 固定单租户。",
    "TenantId": 1
  }
}
