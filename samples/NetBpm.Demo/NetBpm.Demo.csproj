<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>NetBpm.Demo</RootNamespace>
    <AssemblyName>NetBpm.Demo</AssemblyName>
    <UserSecretsId>netbpm-demo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetBpm.Bpmn.Model\NetBpm.Bpmn.Model.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Engine\NetBpm.Engine.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Identity\NetBpm.Identity.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Runtime\NetBpm.Runtime.csproj" />
    <ProjectReference Include="..\..\src\NetBpm.Workflow\NetBpm.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <!--
    两个流程定义的唯一来源都是设计器示例：链接进来而不是复制一份，
    否则「设计器里改的」与「Demo 跑的」迟早会漂移成两份。
  -->
  <ItemGroup>
    <Content Include="..\..\web\designer\examples\order-process.bpmn20.xml"
             Link="processes\order-process.bpmn20.xml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\web\designer\examples\leave-process.bpmn20.xml"
             Link="processes\leave-process.bpmn20.xml"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
