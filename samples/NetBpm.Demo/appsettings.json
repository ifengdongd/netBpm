{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    "//": "引擎与业务数据一起落 MySQL（库 netbpm_demo）。引擎每次启动自动部署两条流程定义。⚠️ 引擎必须是 MySQL：内存执行树的实例 id 每次重启从 1 开始，会撞真库累积行。",
    "DatabaseType": "MySql",
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=netbpm_demo;User ID=root;Password=;Allow User Variables=true;",
    "IdBlockSize": 2500,
    "EnableHistory": true,
    "UseInMemoryExecutionTree": false,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": false
  },
  "Workflow": {
    "TenantId": 1
  },
  "Order": {
    "//TenantId": "order_bill.tenant_id，Demo 固定单租户。",
    "TenantId": 1
  }
}
