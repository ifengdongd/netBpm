<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NetBpm.Persistence</RootNamespace>
    <AssemblyName>NetBpm.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetBpm.Bpmn.Converter\NetBpm.Bpmn.Converter.csproj" />
    <ProjectReference Include="..\NetBpm.Bpmn.Model\NetBpm.Bpmn.Model.csproj" />
    <ProjectReference Include="..\NetBpm.Engine\NetBpm.Engine.csproj" />
    <!-- 平台接入标准（客户端 / 租户 / scope）直接复用对外契约，避免内部再定义一套同名字段 -->
    <ProjectReference Include="..\NetBpm.Platform.Contracts\NetBpm.Platform.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <!--
    把建表脚本拷到输出目录，使运行时（DbMigrate 工具 / Rest 的 AutoMigrate）
    不依赖仓库目录结构 —— DatabaseScripts.ResolveDirectory 会优先看输出目录。
    用 None 而非 Content：Content 会在 dotnet pack 时入包并与 LinkBase 路径冲突（NU5118）。
  -->
  <ItemGroup>
    <None Include="..\..\db\**\*.sql" LinkBase="db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
