{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    "DatabaseType": "MySql",
    "ConnectionString": "",
    "IdBlockSize": 2500,
    "EnableHistory": true,
    "EnableOutbox": false,
    "UseInMemoryExecutionTree": false,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": false,
    "Jobs": {
      "Enabled": true,
      "BatchSize": 50,
      "PollIntervalSeconds": 2,
      "LeaseSeconds": 300,
      "Queue": {
        "Provider": "Redis",
        "Redis": {
          "Host": "127.0.0.1",
          "Port": 6379,
          // 🔐 口令不入库：用 user-secrets 或环境变量注入
          //    dotnet user-secrets set "NetBpm:Jobs:Queue:Redis:Auth" "<password>"
          //    NetBpm__Jobs__Queue__Redis__Auth=<password>
          "Auth": "",
          "Database": 1,
          "KeyPrefix": "netbpm:",
          "Ssl": false
        }
      }
    },
    "Outbox": {
      "Enabled": true,
      "BatchSize": 100,
      "PollIntervalSeconds": 2
    },
    "AdminTenantId": 1,
    "Security": {
      "ApiKey": "",
      "ApiKeyTenants": [],
      // 接入客户端（nbc.* 密钥）与租户引导：见 docs/platform-api-refactoring-plan.md §2.5
      "RequireCredential": false,
      "Clients": {
        "Enabled": true,
        "SecretValidDays": 90,
        "RotationGraceDays": 7
      },
      "Tenants": {
        "Default": "default",
        "DefaultName": "默认租户"
      },
      "Jwt": {
        "SigningKey": "",
        "Issuer": "",
        "Audience": ""
      }
    }
  }
}
