          "Host": "127.0.0.1",
          "Port": 6379,
          "Auth": "",
          "Database": 0,
          "KeyPrefix": "opms:",
          "Ssl": false
        }
      }
    },
    "Outbox": {
      "Enabled": true,
      "BatchSize": 100,
      "PollIntervalSeconds": 2
    },
    "AdminTenantId": 1,
    "Security": {
      "ApiKey": "",
      "ApiKeyTenants": [],
      "Jwt": {
        "SigningKey": "",
        "Issuer": "",
        "Audience": ""
      }
    }
  }
}
