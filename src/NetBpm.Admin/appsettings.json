{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    "DatabaseType": "MySql",
    "ConnectionString": "",
    "IdBlockSize": 2500,
    "EnableHistory": true,
    "EnableOutbox": false,
    "UseInMemoryExecutionTree": false,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": false,
