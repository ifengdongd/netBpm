{
  // 容器形态的默认值：凡是「不配就危险」的，这里都取严格的一侧；
  // 真正随环境变化的值（连接串、凭据、Redis 地址）一律留给环境变量覆盖。
  //
  // 环境变量写法（容器内冒号不方便，用双下划线）：
  //   NetBpm__ConnectionString=Server=mysql;Port=3306;Database=netbpm;User ID=root;Password=***;Allow User Variables=true;
  //   NetBpm__Jobs__Queue__Provider=Redis
  //   NetBpm__Jobs__Queue__Redis__ConnectionString=redis:6379,password=***
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    // ── 存储：独立部署必须落盘 ──
    "UseInMemoryExecutionTree": false,
    "DatabaseType": "MySql",
    "ConnectionString": "",
    // 首启建表（幂等脚本只补缺的东西）。生产上更稳的做法是先 DbMigrate migrate、再关掉这里。
    "AutoMigrate": true,
    "ValidateSchemaOnStartup": true,
    // 平台面（/workflow/v1）的审批历史 / 已办 / 参与者索引依赖 ACT_HI_*，关掉会静默退化
    "EnableHistory": true,
    // ── 异步能力：跨进程投递与重试 ──
    "EnableOutbox": true,
    "Jobs": {
      "Enabled": true,
      "Queue": {
        // Memory 只在单副本下正确；多副本必须换 Redis，否则同一个作业会被重复执行
        "Provider": "Memory"
      }
    },
    // ── 安全：默认要求凭据 ──
    "Security": {
      "RequireCredential": true,
      "Clients": {
        "Enabled": true
      }
    },
    // 限流默认开启（配置在 NetBpmHost 里读取）；测试宿主才需要关
    "RateLimit": {
      "Enabled": true
    }
  }
}
