<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>NetBpm.Workflow</RootNamespace>
    <AssemblyName>NetBpm.Workflow</AssemblyName>
  </PropertyGroup>

  <!-- Hosting/ 里的通用 HTTP 端点（WorkflowEndpoints）需要最小 API 抽象 -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetBpm.Bpmn.Model\NetBpm.Bpmn.Model.csproj" />
    <ProjectReference Include="..\NetBpm.Engine\NetBpm.Engine.csproj" />
    <ProjectReference Include="..\NetBpm.Runtime\NetBpm.Runtime.csproj" />
  </ItemGroup>

  <!--
    依赖说明：Microsoft.Extensions.DependencyInjection.Abstractions / Logging.Abstractions
    与 Hosting 的最小 API 抽象都随 FrameworkReference(Microsoft.AspNetCore.App) 提供，
    不再显式引用（显式引用会触发 NU1510）。
  -->

</Project>
