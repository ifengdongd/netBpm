{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "NetBpm": {
    "DatabaseType": "MySql",
    "ConnectionString": "",
    "IdBlockSize": 2500,
    "EnableHistory": false,
    "EnableOutbox": false,
    "UseInMemoryExecutionTree": true,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": false,
    "Jobs": {
      "Enabled": true,
      "BatchSize": 50,
      "PollIntervalSeconds": 2,
      "LeaseSeconds": 300,
      "Queue": {
        "Provider": "Redis",
        "Redis": {
          "Host": "127.0.0.1",
          "Port": 6379,
          // 🔐 口令不入库：用 user-secrets 或环境变量注入
          //    dotnet user-secrets set "NetBpm:Jobs:Queue:Redis:Auth" "<password>"
          //    NetBpm__Jobs__Queue__Redis__Auth=<password>
          "Auth": "",
          "Database": 1,
          "KeyPrefix": "netbpm:",
          "Ssl": false
        }
      }
    },
    "Outbox": {
      "Enabled": true,
      "BatchSize": 100,
      "PollIntervalSeconds": 2,
      "LeaseSeconds": 300
    },
    "RateLimit": {
      "Enabled": true,
      // Store=Memory：进程内计数（单副本正确，多副本时总配额 = 副本数 × 配置值）
      // Store=Redis：跨副本共享同一个桶，配额才是「全局」的（独立部署多副本时必须开）
      "Store": "Memory",
      "ApiPerMinute": 600,
      "ProbePerMinute": 30,
      "LoginPerMinute": 10,
      // 已注册客户端未配置配额时的兜底；正常取 nb_api_client.quota_per_minute（一系统一配额）
      "ClientPerMinute": 600,
      // 仅当 Store=Redis 时生效。口令不入库：
      //   NetBpm__RateLimit__Redis__Auth=<password>
      //   NetBpm__RateLimit__Redis__ConnectionString=127.0.0.1:6379,password=<password>
      "Redis": {
        "Host": "127.0.0.1",
        "Port": 6379,
        "Auth": "",
        "Database": 1,
        "KeyPrefix": "netbpm:",
        "Ssl": false,
        // Redis 不可用时是否放行（false = 宁可 429 也不失守，代价是 Redis 抖动即全站 429）
        "FailOpenOnError": true
      }
    },
    "MaxRequestBodySizeBytes": 10485760,
    // 跨域：只有「异源前端直连 /workflow/v1」才需要。管理端与设计器由 wwwroot 同源托管，不用配。
    // 必须逐个列来源（scheme://host[:port]），不支持通配；留空 = 不启用 CORS。
    // 例：["https://approve.example.com", "http://localhost:5173"]
    "Cors": {
      "AllowedOrigins": []
    },
    "Security": {
      "ApiKey": "",
      "ApiKeyTenants": [],
      // 接入客户端（nbc.* 密钥）与租户引导：见 docs/platform-api-refactoring-plan.md §2.5
      "RequireCredential": false,
      "Clients": {
        "Enabled": true,
        "SecretValidDays": 90,
        "RotationGraceDays": 7
      },
      "Tenants": {
        "Default": "default",
        "DefaultName": "默认租户"
      },
      "Jwt": {
        "SigningKey": "",
        "Issuer": "",
        "Audience": ""
      }
    }
  }
}
