{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "NetBpm": {
    "DatabaseType": "MySql",
    // 与控制台 5081 共用同一个库（单库形态）；集成测试另有 netbpm_ittest
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=netbpm_admin;User ID=root;Password=;Allow User Variables=true;",
    "IdBlockSize": 2500,
    // 平台面（/workflow/v1）的审批历史 / 已办 / 参与者索引依赖 ACT_HI_*，关掉会静默退化
    "EnableHistory": true,
    "UseInMemoryExecutionTree": false,
    "ValidateSchemaOnStartup": true,
    "AutoMigrate": true
  }
}
