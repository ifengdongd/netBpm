<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:activiti="http://activiti.org/bpmn"
                  id="Definitions_DeptApproval"
                  targetNamespace="http://netbpm/bpmn">
  <!--
    部门审批流程（演示「审批人从外部系统动态获取」）。

    核心演示点：经理审批节点 task_manager_approve **不写任何静态审批人**（没有
    assignee / candidateUsers / candidateGroups）。引擎进入该节点时，会以「空办理人集合」
    调用宿主注册的 IApproverResolver（见 samples/NetBpm.Demo/Approval/DynamicApproverResolver.cs），
    解析器拿到的上下文里有：
      - BusinessKey（业务单号）
      - Variables（流程变量，含发起时传入的 applyDeptId）
      - ActivityId（= 节点 id，被解析器映射成「职位」）
    解析器据此「按部门 id + 职位」查外部系统，返回审批人，引擎把返回的人写入候选用户
    （进「我的待办」候选池，支持多审批人会签）。

    流转规则：
      1. 发起时传 applyDeptId（申请部门 id，如 "102"），businessKey 留空自动发号；
      2. 「经理审批」的审批人由解析器按 applyDeptId 定位（102 → manager1；101 → leader1 …）；
      3. approvalResult == 1 通过 → dept.ApproveComplete；== 2 拒绝 → dept.RefuseComplete；
         == 3 驳回修改 → 简化等价「拒绝」（本流程演示重点是动态审批人，不做驳回回路）；
         默认流兜底「拒绝」（保守方向）。

    流程变量（BaseModel，扁平变量）：
      发起时写入：businessId / businessDeptId / applyUser / applyTime / applyDeptId
      审批时写入：result / comment

    ⚠️ approvalResult 的选项必须与 ApprovalResult 枚举 [1,2,3] 一一对应（ApprovalFormGuard 自检），
       因此「驳回修改」选项保留（即使本流程不做驳回回路，也走拒绝结束）。
    ⚠️ 网关 default 流指向「拒绝」：条件全假/变量缺失时宁可拒绝，也不静默放行。
  -->
  <bpmn:process id="dept_approval_process" name="部门审批流程" isExecutable="true">
    <bpmn:startEvent id="start" name="发起部门审批" activiti:initiator="applyUser">
      <bpmn:outgoing>flow_start_manager</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_manager_approve" name="经理审批" activiti:formKey="dept-approve">
      <bpmn:extensionElements>
        <activiti:formProperty id="approvalResult" name="审批结果" type="enum" required="true" variable="result">
          <activiti:value id="1" name="通过" />
          <activiti:value id="2" name="拒绝" />
          <activiti:value id="3" name="驳回修改" />
        </activiti:formProperty>
        <activiti:formProperty id="comment" name="审批说明" type="string" variable="comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_start_manager</bpmn:incoming>
      <bpmn:outgoing>flow_manager_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_manager" name="经理审批结果" default="flow_manager_refuse">
      <bpmn:incoming>flow_manager_gw</bpmn:incoming>
      <bpmn:outgoing>flow_manager_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_manager_refuse</bpmn:outgoing>
      <bpmn:outgoing>flow_manager_modify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_approve_complete" name="审批通过" activiti:delegateExpression="dept.ApproveComplete">
      <bpmn:incoming>flow_manager_pass</bpmn:incoming>
      <bpmn:outgoing>flow_approve_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_refuse" name="拒绝结束" activiti:delegateExpression="dept.RefuseComplete">
      <bpmn:incoming>flow_manager_refuse</bpmn:incoming>
      <bpmn:incoming>flow_manager_modify</bpmn:incoming>
      <bpmn:outgoing>flow_refuse_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_approved" name="审批通过结束">
      <bpmn:incoming>flow_approve_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_refused" name="审批拒绝结束">
      <bpmn:incoming>flow_refuse_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_manager" sourceRef="start" targetRef="task_manager_approve" />
    <bpmn:sequenceFlow id="flow_manager_gw" sourceRef="task_manager_approve" targetRef="gw_manager" />
    <bpmn:sequenceFlow id="flow_manager_pass" sourceRef="gw_manager" targetRef="task_approve_complete" name="通过">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_manager_refuse" sourceRef="gw_manager" targetRef="task_refuse" name="拒绝" />
    <bpmn:sequenceFlow id="flow_manager_modify" sourceRef="gw_manager" targetRef="task_refuse" name="驳回修改">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approve_end" sourceRef="task_approve_complete" targetRef="end_approved" />
    <bpmn:sequenceFlow id="flow_refuse_end" sourceRef="task_refuse" targetRef="end_refused" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_DeptApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_DeptApproval" bpmnElement="dept_approval_process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="62" y="225" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_manager_approve_di" bpmnElement="task_manager_approve">
        <dc:Bounds x="180" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_manager_di" bpmnElement="gw_manager">
        <dc:Bounds x="380" y="180" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="225" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_complete_di" bpmnElement="task_approve_complete">
        <dc:Bounds x="520" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_refuse_di" bpmnElement="task_refuse">
        <dc:Bounds x="520" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_approved_di" bpmnElement="end_approved">
        <dc:Bounds x="720" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="185" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_refused_di" bpmnElement="end_refused">
        <dc:Bounds x="720" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="345" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_manager_di" bpmnElement="flow_start_manager">
        <di:waypoint x="116" y="200" />
        <di:waypoint x="180" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_manager_gw_di" bpmnElement="flow_manager_gw">
        <di:waypoint x="300" y="200" />
        <di:waypoint x="380" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_manager_pass_di" bpmnElement="flow_manager_pass">
        <di:waypoint x="400" y="180" />
        <di:waypoint x="400" y="160" />
        <di:waypoint x="520" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="142" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_manager_refuse_di" bpmnElement="flow_manager_refuse">
        <di:waypoint x="400" y="220" />
        <di:waypoint x="400" y="320" />
        <di:waypoint x="520" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="302" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_manager_modify_di" bpmnElement="flow_manager_modify">
        <di:waypoint x="420" y="200" />
        <di:waypoint x="420" y="360" />
        <di:waypoint x="560" y="360" />
        <di:waypoint x="560" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="470" y="352" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_end_di" bpmnElement="flow_approve_end">
        <di:waypoint x="640" y="160" />
        <di:waypoint x="720" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refuse_end_di" bpmnElement="flow_refuse_end">
        <di:waypoint x="640" y="320" />
        <di:waypoint x="720" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
