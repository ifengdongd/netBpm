<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:activiti="http://activiti.org/bpmn"
                  id="Definitions_Order"
                  targetNamespace="http://netbpm/bpmn">
  <!--
    订单审批流程（NetBpm 子集示例，配套 samples/NetBpm.Demo）。

    流转规则：
      1. 业务侧「提交申请」（POST /api/order/bills）发起流程，order_bill.status 写 1（审批中）；
      2. 「经理审批」的审批选项来自表单属性 approvalResult（enum）== 1 通过 / 2 拒绝 / 3 驳回修改，
         其 variable="result" 把选择结果映射为流程变量 result；另有 comment（审批说明）；
      3. result == 2 →「拒绝结束」服务任务（order.RefuseComplete）→ order_bill.status 写 -1；
         result == 3 →「申请人修改」，改完回到经理审批（默认流，兜底）；订单保持审批中（1）；
         result == 1 →「审批通过」服务任务（order.ApproveComplete）→ order_bill.status 写 100。

    流程变量（BaseModel，全部为扁平变量）：
      发起时写入：businessId / businessDeptId / applyUser / applyTime / applyDeptId
      流程参数：product_name / amount / remark（发起时经 paraDict 写入，存 order_bill 真列）
      审批时写入：result / comment

    ⚠️ 网关设了 default 流（本子集要求排他网关必须有可选流）。
  -->
  <bpmn:process id="order_process" name="订单审批流程" isExecutable="true">
    <bpmn:startEvent id="start" name="提交订单申请">
      <bpmn:outgoing>flow_start_approve</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_manager_approve" name="经理审批" activiti:candidateGroups="managers" activiti:formKey="order-approve">
      <bpmn:extensionElements>
        <activiti:formProperty id="approvalResult" name="审批结果" type="enum" required="true" variable="result">
          <activiti:value id="1" name="通过" />
          <activiti:value id="2" name="拒绝" />
          <activiti:value id="3" name="驳回修改" />
        </activiti:formProperty>
        <activiti:formProperty id="comment" name="审批说明" type="string" variable="comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_start_approve</bpmn:incoming>
      <bpmn:incoming>flow_modify_approve</bpmn:incoming>
      <bpmn:outgoing>flow_approve_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_manager" name="经理审批结果" default="flow_gw_modify">
      <bpmn:incoming>flow_approve_gw</bpmn:incoming>
      <bpmn:outgoing>flow_gw_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_refuse</bpmn:outgoing>
      <bpmn:outgoing>flow_gw_modify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_apply_modify" name="申请人修改" activiti:assignee="${applyUser}" activiti:formKey="order-apply">
      <bpmn:extensionElements>
        <activiti:formProperty id="amount" name="订单金额" type="long" required="true" variable="amount" />
        <activiti:formProperty id="remark" name="备注" type="string" variable="remark" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_gw_modify</bpmn:incoming>
      <bpmn:outgoing>flow_modify_approve</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="task_approve_complete" name="审批通过" activiti:delegateExpression="order.ApproveComplete">
      <bpmn:incoming>flow_gw_pass</bpmn:incoming>
      <bpmn:outgoing>flow_approve_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_refuse" name="拒绝结束" activiti:delegateExpression="order.RefuseComplete">
      <bpmn:incoming>flow_gw_refuse</bpmn:incoming>
      <bpmn:outgoing>flow_refuse_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_approved" name="审批通过结束">
      <bpmn:incoming>flow_approve_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_refused" name="审批拒绝结束">
      <bpmn:incoming>flow_refuse_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_approve" sourceRef="start" targetRef="task_manager_approve" />
    <bpmn:sequenceFlow id="flow_approve_gw" sourceRef="task_manager_approve" targetRef="gw_manager" />
    <bpmn:sequenceFlow id="flow_gw_pass" sourceRef="gw_manager" targetRef="task_approve_complete" name="通过">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw_refuse" sourceRef="gw_manager" targetRef="task_refuse" name="拒绝">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gw_modify" sourceRef="gw_manager" targetRef="task_apply_modify" name="驳回修改" />
    <bpmn:sequenceFlow id="flow_modify_approve" sourceRef="task_apply_modify" targetRef="task_manager_approve" name="修改后重提" />
    <bpmn:sequenceFlow id="flow_approve_end" sourceRef="task_approve_complete" targetRef="end_approved" />
    <bpmn:sequenceFlow id="flow_refuse_end" sourceRef="task_refuse" targetRef="end_refused" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="order_process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="62" y="245" width="72" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_manager_approve_di" bpmnElement="task_manager_approve">
        <dc:Bounds x="180" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_manager_di" bpmnElement="gw_manager">
        <dc:Bounds x="380" y="200" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="360" y="247" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_modify_di" bpmnElement="task_apply_modify">
        <dc:Bounds x="260" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_complete_di" bpmnElement="task_approve_complete">
        <dc:Bounds x="520" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_refuse_di" bpmnElement="task_refuse">
        <dc:Bounds x="520" y="280" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_approved_di" bpmnElement="end_approved">
        <dc:Bounds x="720" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="185" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_refused_di" bpmnElement="end_refused">
        <dc:Bounds x="720" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="345" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_approve_di" bpmnElement="flow_start_approve">
        <di:waypoint x="116" y="220" />
        <di:waypoint x="180" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_gw_di" bpmnElement="flow_approve_gw">
        <di:waypoint x="300" y="220" />
        <di:waypoint x="380" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_pass_di" bpmnElement="flow_gw_pass">
        <di:waypoint x="400" y="200" />
        <di:waypoint x="400" y="160" />
        <di:waypoint x="520" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="142" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_refuse_di" bpmnElement="flow_gw_refuse">
        <di:waypoint x="400" y="240" />
        <di:waypoint x="400" y="320" />
        <di:waypoint x="520" y="320" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430" y="302" width="28" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_gw_modify_di" bpmnElement="flow_gw_modify">
        <di:waypoint x="420" y="220" />
        <di:waypoint x="470" y="220" />
        <di:waypoint x="470" y="380" />
        <di:waypoint x="380" y="380" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="362" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_modify_approve_di" bpmnElement="flow_modify_approve">
        <di:waypoint x="320" y="340" />
        <di:waypoint x="320" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="330" y="292" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_approve_end_di" bpmnElement="flow_approve_end">
        <di:waypoint x="640" y="160" />
        <di:waypoint x="720" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_refuse_end_di" bpmnElement="flow_refuse_end">
        <di:waypoint x="640" y="320" />
        <di:waypoint x="720" y="320" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
