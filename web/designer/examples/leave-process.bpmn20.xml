<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:activiti="http://activiti.org/bpmn"
                  id="Definitions_Leave"
                  targetNamespace="http://netbpm/bpmn">
  <!--
    请假审批流程（NetBpm 子集示例）。

    流转规则（与 samples/NetBpm.Demo 的审批 Demo 配套）：
      1. 发起后「提交请假申请」→「组长审批」；
      2. 组长审批的审批选项来自表单属性 approvalResult（enum）== 1 通过 / 2 拒绝 / 3 驳回修改，
         其 variable="result" 即把选择结果映射为流程变量 result；
         同环节另有 comment（string）收集审批说明，variable="comment"；
      3. result == 2 →「拒绝结束」服务任务（leave.RefuseComplete）；
         result == 3 →「申请人修改」，改完回到组长审批（默认流，兜底）；
         result == 1 → 继续判断 days（请假天数）：
              days <= 3 → 直接「审批通过」（leave.ApproveComplete）；
              days  > 3 →「经理审批」，其审批选项与审批说明同样来自 approvalResult / comment；
                          经理 result == 1 →「审批通过」；== 2 →「拒绝结束」；
                          默认（驳回修改）→「申请人修改」。
              days 缺失/非法 → 走默认流「退回补充」→「申请人修改」（兜底方向必须是保守的，
                               不能因为表单少填一个字段就静默"审批通过"）。

    流程变量（BaseModel，全部为扁平变量，见 Demo 的 Workflow/BaseModel.cs）：
      发起时写入：businessId / businessDeptId / applyUser / applyTime / applyDeptId
      审批时写入：result / comment
      ⚠️ assignee 用 ${applyUser}（申请人）而不是某个 Demo 内部变量名 —— 变量名是流程契约的一部分。
      ⚠️ applyUser 的正常来源是开始事件的 activiti:initiator="applyUser"（引擎在启动时写入 startUserId）。
         平台的引擎面发起（POST /api/runtime/process-instances）不会替你补这个变量，
         缺了它 assignee 求值就抛 ElException；业务宿主自己写同名的值也是合法来源。

    审批节点的候选人（演示口径）：
      两个审批节点都用 assignee="${applyUser}"，即「发起人自己可批」，一个账号就能演完闭环。
      ⚠️ 不要写 candidateUsers="${initiator}"：candidateUsers 求值要求字符串/集合变量，
      而 initiator 不是流程变量（它启动时已被写成 applyUser），运行时会 400
      "Expression did not resolve to a string or collection of strings"。
      ⚠️ 不要照抄成 candidateGroups="leaders" 去演示：控制台默认没接 IUserGroupManager，
         组展开是 0 人 —— 任务照样建出来，但任何人的「我的待办」里都看不到（静默卡住）。
         接真实组织时改成具体用户 id，或继续用组并在宿主注册 IUserGroupManager。

    ⚠️ 三条排他网关都设置了 default 流：本子集「排他网关每条出流都带条件且无默认流」会被
       校验规则 exclusive-gateway-has-selectable-flow 拒部署（条件全假时选不出流）。
       默认流必须指向本网关的真实出流，且不要写条件（default-flow 规则）—— 写了也不参与判定。
       默认流的兜底方向统一是「退回/转人工」，不默认「通过」。

    监听器（对齐 Java 端的两个实现，见 Demo 的 Leave/WorkFlowListeners.cs）：
      - 流程级 activiti:eventListener：events=TASK_COMPLETED，任务每次完成即通知
        （Java 端在这里写 deal_history / 删 instance_current_task；NetBpm 由应用层落库）；
        通过 execution.EventName 区分事件。
  -->
  <bpmn:process id="leave_process" name="请假流程" isExecutable="true">
    <bpmn:extensionElements>
      <activiti:eventListener events="TASK_COMPLETED" delegateExpression="${WorkFlowTaskCompletedListener}" />
        <activiti:executionListener event="start" delegateExpression="${WorkFlowProcessListener}" />
        <activiti:executionListener event="take" delegateExpression="${WorkFlowProcessListener}" />
        <activiti:executionListener event="end" delegateExpression="${WorkFlowProcessListener}" />
    </bpmn:extensionElements>
    <!--
      activiti:initiator="applyUser"：发起时引擎把 startUserId 写进变量 applyUser。
      没有它，平台的引擎面发起（POST /api/runtime/process-instances）不会替你补这个变量，
      下面 assignee="${applyUser}" 求值会抛 ElException（表现为 422 engine.expression_error）。
    -->
    <bpmn:startEvent id="start" name="发起请假" activiti:initiator="applyUser">
      <bpmn:outgoing>flow_start_apply</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_apply" name="提交请假申请" activiti:assignee="${applyUser}" activiti:formKey="leave-apply">
      <bpmn:extensionElements>
        <activiti:formProperty id="days" name="请假天数" type="long" required="true" variable="days" />
        <activiti:formProperty id="reason" name="请假事由" type="string" variable="reason" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_start_apply</bpmn:incoming>
      <bpmn:outgoing>flow_apply_leader</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_leader_approve" name="组长审批" activiti:assignee="${applyUser}" activiti:formKey="leave-approve">
      <bpmn:extensionElements>
        <activiti:formProperty id="approvalResult" name="审批结果" type="enum" required="true" variable="result">
          <activiti:value id="1" name="通过" />
          <activiti:value id="2" name="拒绝" />
          <activiti:value id="3" name="驳回修改" />
        </activiti:formProperty>
        <activiti:formProperty id="comment" name="审批说明" type="string" variable="comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_apply_leader</bpmn:incoming>
      <bpmn:incoming>flow_modify_leader</bpmn:incoming>
      <bpmn:outgoing>flow_leader_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_leader" name="组长审批结果" default="flow_leader_modify">
      <bpmn:incoming>flow_leader_gw</bpmn:incoming>
      <bpmn:outgoing>flow_leader_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_leader_refuse</bpmn:outgoing>
      <bpmn:outgoing>flow_leader_modify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_apply_modify" name="申请人修改" activiti:assignee="${applyUser}" activiti:formKey="leave-apply">
      <bpmn:extensionElements>
        <activiti:formProperty id="days" name="请假天数" type="long" required="true" variable="days" />
        <activiti:formProperty id="reason" name="请假事由" type="string" variable="reason" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_leader_modify</bpmn:incoming>
      <bpmn:incoming>flow_manager_modify</bpmn:incoming>
      <bpmn:incoming>flow_days_modify</bpmn:incoming>
      <bpmn:outgoing>flow_modify_leader</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_days" name="请假天数判断" default="flow_days_modify">
      <bpmn:incoming>flow_leader_pass</bpmn:incoming>
      <bpmn:outgoing>flow_days_over3</bpmn:outgoing>
      <bpmn:outgoing>flow_days_within3</bpmn:outgoing>
      <bpmn:outgoing>flow_days_modify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_manager_approve" name="经理审批" activiti:assignee="${applyUser}" activiti:formKey="leave-approve">
      <bpmn:extensionElements>
        <activiti:formProperty id="approvalResult" name="审批结果" type="enum" required="true" variable="result">
          <activiti:value id="1" name="通过" />
          <activiti:value id="2" name="拒绝" />
          <activiti:value id="3" name="驳回修改" />
        </activiti:formProperty>
        <activiti:formProperty id="comment" name="审批说明" type="string" variable="comment" />
      </bpmn:extensionElements>
      <bpmn:incoming>flow_days_over3</bpmn:incoming>
      <bpmn:outgoing>flow_manager_gw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_manager" name="经理审批结果" default="flow_manager_modify">
      <bpmn:incoming>flow_manager_gw</bpmn:incoming>
      <bpmn:outgoing>flow_manager_pass</bpmn:outgoing>
      <bpmn:outgoing>flow_manager_refuse</bpmn:outgoing>
      <bpmn:outgoing>flow_manager_modify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="task_approve_complete" name="审批通过" activiti:delegateExpression="leave.ApproveComplete">
      <bpmn:incoming>flow_days_within3</bpmn:incoming>
      <bpmn:incoming>flow_manager_pass</bpmn:incoming>
      <bpmn:outgoing>flow_approve_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="task_refuse" name="拒绝结束" activiti:delegateExpression="leave.RefuseComplete">
      <bpmn:incoming>flow_leader_refuse</bpmn:incoming>
      <bpmn:incoming>flow_manager_refuse</bpmn:incoming>
      <bpmn:outgoing>flow_refuse_end</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end_approved" name="审批通过结束">
      <bpmn:incoming>flow_approve_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_refused" name="审批拒绝结束">
      <bpmn:incoming>flow_refuse_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_start_apply" sourceRef="start" targetRef="task_apply" />
    <bpmn:sequenceFlow id="flow_apply_leader" sourceRef="task_apply" targetRef="task_leader_approve" />
    <bpmn:sequenceFlow id="flow_leader_gw" sourceRef="task_leader_approve" targetRef="gw_leader" />
    <bpmn:sequenceFlow id="flow_leader_pass" sourceRef="gw_leader" targetRef="gw_days" name="通过">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_leader_refuse" sourceRef="gw_leader" targetRef="task_refuse" name="拒绝">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_leader_modify" sourceRef="gw_leader" targetRef="task_apply_modify" name="驳回修改" />
    <bpmn:sequenceFlow id="flow_modify_leader" sourceRef="task_apply_modify" targetRef="task_leader_approve" name="修改后重提" />
    <bpmn:sequenceFlow id="flow_days_over3" sourceRef="gw_days" targetRef="task_manager_approve" name="超过3天">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${days &gt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_days_within3" sourceRef="gw_days" targetRef="task_approve_complete" name="3天及以内">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${days &lt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_days_modify" sourceRef="gw_days" targetRef="task_apply_modify" name="天数缺失或非法 → 退回补充" />
    <bpmn:sequenceFlow id="flow_manager_gw" sourceRef="task_manager_approve" targetRef="gw_manager" />
    <bpmn:sequenceFlow id="flow_manager_pass" sourceRef="gw_manager" targetRef="task_approve_complete" name="通过">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 1}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_manager_refuse" sourceRef="gw_manager" targetRef="task_refuse" name="拒绝">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${result == 2}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_manager_modify" sourceRef="gw_manager" targetRef="task_apply_modify" name="驳回修改" />
    <bpmn:sequenceFlow id="flow_approve_end" sourceRef="task_approve_complete" targetRef="end_approved" />
    <bpmn:sequenceFlow id="flow_refuse_end" sourceRef="task_refuse" targetRef="end_refused" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Leave">
    <bpmndi:BPMNPlane id="BPMNPlane_Leave" bpmnElement="leave_process">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="80" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="68" y="225" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_di" bpmnElement="task_apply">
        <dc:Bounds x="160" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_leader_approve_di" bpmnElement="task_leader_approve">
        <dc:Bounds x="320" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_leader_di" bpmnElement="gw_leader">
        <dc:Bounds x="480" y="180" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="225" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_apply_modify_di" bpmnElement="task_apply_modify">
        <dc:Bounds x="320" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_days_di" bpmnElement="gw_days">
        <dc:Bounds x="620" y="180" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="225" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_manager_approve_di" bpmnElement="task_manager_approve">
        <dc:Bounds x="740" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_manager_di" bpmnElement="gw_manager">
        <dc:Bounds x="900" y="180" width="40" height="40" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="225" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_approve_complete_di" bpmnElement="task_approve_complete">
        <dc:Bounds x="1000" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_refuse_di" bpmnElement="task_refuse">
        <dc:Bounds x="1000" y="20" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_approved_di" bpmnElement="end_approved">
        <dc:Bounds x="1160" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1136" y="225" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_refused_di" bpmnElement="end_refused">
        <dc:Bounds x="1160" y="42" width="36" height="36" />
